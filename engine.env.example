# Copiar futuramente para o .env do motor. Não versionar o arquivo real.
# Percent-encode de caracteres especiais na senha da URL.
DATABASE_URL=postgresql+psycopg://srv_dataqore_engine:SUBSTITUIR@HOST:5432/dataqore_engine?sslmode=prefer
MIGRATION_DATABASE_URL=postgresql+psycopg://srv_dataqore_engine_migrator:SUBSTITUIR@HOST:5432/dataqore_engine?sslmode=prefer
ENGINE_API_KEY=SUBSTITUIR_PELO_MESMO_SEGREDO_DO_CONTROLLER
# Gerar uma chave Fernet real quando configurar o motor; não é a senha do Postgres.
CONNECTIONS_ENCRYPTION_KEY=SUBSTITUIR_POR_CHAVE_FERNET
CONNECTIONS_ENCRYPTION_KEY_VERSION=v1
