# Copiar futuramente para o .env do controller. Não versionar o arquivo real.
# Percent-encode de caracteres especiais na senha da URL.
# Substituir HOST, porta publicada pelo container e senha.
# sslmode=require somente se o servidor estiver configurado com TLS.
DATABASE_URL=postgresql://srv_dataqore_app:SUBSTITUIR@HOST:5432/dataqore_app?schema=app&sslmode=verify-full
# Exclusiva dos comandos de migrations; nunca usar como conexão do serviço.
MIGRATION_DATABASE_URL=postgresql://srv_dataqore_app_migrator:SUBSTITUIR@HOST:5432/dataqore_app?schema=app&sslmode=verify-full
ENGINE_API_URL=http://127.0.0.1:8000
ENGINE_API_KEY=SUBSTITUIR_POR_SEGREDO_INTERNO
# Origem exata do Vite local; manter 127.0.0.1 ao abrir no navegador.
WEB_ORIGIN=http://127.0.0.1:5173
# Gerar com: node -e 'console.log(require("node:crypto").randomBytes(48).toString("base64url"))'
JWT_SECRET=SUBSTITUIR_POR_SEGREDO_ALEATORIO_DE_32_CARACTERES_OU_MAIS
ACCESS_TOKEN_SECONDS=900
REFRESH_TOKEN_SECONDS=604800

# 32 random bytes, base64url without padding; preserve separately from database backups.
IDENTITY_ENCRYPTION_KEY=
