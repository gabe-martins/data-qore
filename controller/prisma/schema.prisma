generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["app"]
}

// CHECKs, grants e índice por lower(email) ficam no SQL versionado.
model User {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String        @db.Text
  displayName  String        @map("display_name") @db.Text
  passwordHash String        @map("password_hash") @db.Text
  groupId      String        @map("group_id") @db.Uuid
  group        AccessGroup   @relation(fields: [groupId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  mustChangePassword Boolean @default(false) @map("must_change_password")
  isActive     Boolean       @default(true) @map("is_active")
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime      @default(now()) @map("updated_at") @db.Timestamptz(6)
  sessions     AuthSession[]
  auditLog     AuditLog[]
  schedules    Schedule[]

  @@index([groupId], map: "users_group_idx")
  @@map("users")
  @@schema("app")
}

model Schedule {
  id             String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String             @db.Text
  comparisonId   String             @map("comparison_id") @db.Uuid
  cronExpression String             @map("cron_expression") @db.Text
  timezone       String             @default("America/Sao_Paulo") @db.Text
  isActive       Boolean            @default(true) @map("is_active")
  nextRunAt      DateTime           @map("next_run_at") @db.Timestamptz(6)
  createdBy      String?            @map("created_by") @db.Uuid
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime           @default(now()) @map("updated_at") @db.Timestamptz(6)
  creator        User?              @relation(fields: [createdBy], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "schedules_created_by_fkey")
  dispatches     ScheduleDispatch[]

  @@index([isActive, nextRunAt], map: "schedules_due_idx")
  @@index([comparisonId], map: "schedules_comparison_idx")
  @@map("schedules")
  @@schema("app")
}

model ScheduleDispatch {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  scheduleId     String    @map("schedule_id") @db.Uuid
  comparisonId   String    @map("comparison_id") @db.Uuid
  scheduledFor   DateTime  @map("scheduled_for") @db.Timestamptz(6)
  status         String    @default("pending") @db.Text
  attempts       Int       @default(0)
  enqueueStarted Boolean   @default(false) @map("enqueue_started")
  runId          String?   @map("run_id") @db.Uuid
  errorCode      String?   @map("error_code") @db.Text
  retryAt        DateTime  @default(now()) @map("retry_at") @db.Timestamptz(6)
  leaseUntil     DateTime? @map("lease_until") @db.Timestamptz(6)
  claimToken     String?   @map("claim_token") @db.Uuid
  finishedAt     DateTime? @map("finished_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  schedule       Schedule  @relation(fields: [scheduleId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "schedule_dispatches_schedule_id_fkey")

  @@unique([scheduleId, scheduledFor], map: "schedule_dispatches_schedule_id_scheduled_for_key")
  @@index([status, retryAt], map: "schedule_dispatches_pending_idx")
  @@map("schedule_dispatches")
  @@schema("app")
}

model AuthSession {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  refreshTokenHash String    @unique(map: "auth_sessions_refresh_token_hash_key") @map("refresh_token_hash") @db.Text
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "auth_sessions_user_id_fkey")

  @@index([userId], map: "auth_sessions_user_idx")
  @@index([expiresAt], map: "auth_sessions_expiry_idx")
  @@map("auth_sessions")
  @@schema("app")
}

model AuditLog {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorUserId  String?  @map("actor_user_id") @db.Uuid
  action       String   @db.Text
  resourceType String   @map("resource_type") @db.Text
  resourceId   String?  @map("resource_id") @db.Text
  requestId    String?  @map("request_id") @db.Uuid
  outcome      String   @db.Text
  details      Json     @default("{}") @db.JsonB
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  actor        User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "audit_log_actor_user_id_fkey")

  @@index([createdAt(sort: Desc)], map: "audit_log_created_idx")
  @@index([actorUserId, createdAt(sort: Desc)], map: "audit_log_actor_idx")
  @@map("audit_log")
  @@schema("app")
}

model AccessGroup {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name String @db.Text
  description String @default("") @db.Text
  profile String @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  users User[]

  @@map("access_groups")
  @@schema("app")
}
