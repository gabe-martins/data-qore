{
  "name": "@dataqore/controller",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "schema:validate": "prisma validate",
    "db:check": "../engine/.venv/bin/python ../tools/migrations.py app check",
    "db:verify": "../engine/.venv/bin/python ../tools/migrations.py app verify",
    "db:status": "../engine/.venv/bin/python ../tools/migrations.py app status",
    "db:baseline": "../engine/.venv/bin/python ../tools/migrations.py app baseline",
    "db:migrate": "../engine/.venv/bin/python ../tools/migrations.py app apply",
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/main.js",
    "prisma:generate": "prisma generate",
    "admin:create": "node --import tsx src/admin.ts create",
    "admin:reset-password": "node --import tsx src/admin.ts reset-password",
    "openapi:export": "node --import tsx scripts/openapi.ts",
    "types:generate": "openapi-typescript ../docs/openapi-engine.json -o src/engine-api.d.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "db:runtime-check": "node --import tsx src/check.ts"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "openapi-typescript": "7.13.0",
    "prisma": "7.10.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.3",
    "@fastify/rate-limit": "11.2.1",
    "@nestjs/common": "12.1.3",
    "@nestjs/core": "12.1.3",
    "@nestjs/platform-fastify": "12.1.3",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "argon2": "0.45.1",
    "cron-parser": "5.10.2",
    "dotenv": "18.0.8",
    "jose": "6.2.12",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  }
}
