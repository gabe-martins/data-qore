  "constraints": [
    {
      "relname": "audit_log",
      "conname": "audit_log_action_check",
      "contype": "c",
      "definition": "CHECK (btrim(action) <> ''::text)"
    },
    {
      "relname": "audit_log",
      "conname": "audit_log_actor_user_id_fkey",
      "contype": "f",
      "definition": "FOREIGN KEY (actor_user_id) REFERENCES app.users(id) ON DELETE SET NULL"
    },
    {
      "relname": "audit_log",
      "conname": "audit_log_details_check",
      "contype": "c",
      "definition": "CHECK (jsonb_typeof(details) = 'object'::text)"
    },
    {
      "relname": "audit_log",
      "conname": "audit_log_outcome_check",
      "contype": "c",
      "definition": "CHECK (outcome = ANY (ARRAY['success'::text, 'failure'::text]))"
    },
    {
      "relname": "audit_log",
      "conname": "audit_log_pkey",
      "contype": "p",
      "definition": "PRIMARY KEY (id)"
    },
    {
      "relname": "audit_log",
      "conname": "audit_log_resource_type_check",
      "contype": "c",
      "definition": "CHECK (btrim(resource_type) <> ''::text)"
    },
    {
      "relname": "auth_sessions",
      "conname": "auth_sessions_check",
      "contype": "c",
      "definition": "CHECK (expires_at > created_at)"
    },
    {
      "relname": "auth_sessions",
      "conname": "auth_sessions_check1",
      "contype": "c",
      "definition": "CHECK (revoked_at IS NULL OR revoked_at >= created_at)"
    },
    {
      "relname": "auth_sessions",
      "conname": "auth_sessions_pkey",
      "contype": "p",
      "definition": "PRIMARY KEY (id)"
    },
    {
      "relname": "auth_sessions",
      "conname": "auth_sessions_refresh_token_hash_check",
      "contype": "c",
      "definition": "CHECK (refresh_token_hash <> ''::text)"
    },
    {
      "relname": "auth_sessions",
      "conname": "auth_sessions_refresh_token_hash_key",
      "contype": "u",
      "definition": "UNIQUE (refresh_token_hash)"
    },
    {
      "relname": "auth_sessions",
      "conname": "auth_sessions_user_id_fkey",
      "contype": "f",
      "definition": "FOREIGN KEY (user_id) REFERENCES app.users(id) ON DELETE CASCADE"
    },
    {
      "relname": "users",
      "conname": "users_display_name_check",
      "contype": "c",
      "definition": "CHECK (btrim(display_name) <> ''::text)"
    },
    {
      "relname": "users",
      "conname": "users_email_check",
      "contype": "c",
      "definition": "CHECK (email = btrim(email) AND email <> ''::text)"
    },
    {
      "relname": "users",
      "conname": "users_password_hash_check",
      "contype": "c",
      "definition": "CHECK (password_hash <> ''::text)"
    },
    {
      "relname": "users",
      "conname": "users_pkey",
      "contype": "p",
      "definition": "PRIMARY KEY (id)"
    },
    {
      "relname": "users",
      "conname": "users_role_check",
      "contype": "c",
      "definition": "CHECK (role = 'admin'::text)"
    }
  ],
