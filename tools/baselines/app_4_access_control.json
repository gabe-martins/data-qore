  "constraints": [
    {
      "relname": "access_groups",
      "conname": "access_groups_description_check",
      "contype": "c",
      "definition": "CHECK (length(description) <= 1000)"
    },
    {
      "relname": "access_groups",
      "conname": "access_groups_name_check",
      "contype": "c",
      "definition": "CHECK (name = btrim(name) AND name <> ''::text AND length(name) <= 255)"
    },
    {
      "relname": "access_groups",
      "conname": "access_groups_pkey",
      "contype": "p",
      "definition": "PRIMARY KEY (id)"
    },
    {
      "relname": "access_groups",
      "conname": "access_groups_profile_check",
      "contype": "c",
      "definition": "CHECK (profile = ANY (ARRAY['viewer'::text, 'quality_manager'::text, 'developer'::text, 'platform_admin'::text]))"
    },
    {
      "relname": "audit_log",
      "conname": "audit_log_action_check",
      "contype": "c",
      "definition": "CHECK (btrim(action) <> ''::text)"
    },
    {
      "relname": "audit_log",
      "conname": "audit_log_actor_user_id_fkey",
      "contype": "f",
      "definition": "FOREIGN KEY (actor_user_id) REFERENCES app.users(id) ON DELETE SET NULL"
    },
    {
      "relname": "audit_log",
      "conname": "audit_log_details_check",
      "contype": "c",
      "definition": "CHECK (jsonb_typeof(details) = 'object'::text)"
    },
    {
      "relname": "audit_log",
      "conname": "audit_log_outcome_check",
      "contype": "c",
      "definition": "CHECK (outcome = ANY (ARRAY['success'::text, 'failure'::text]))"
    },
    {
      "relname": "audit_log",
      "conname": "audit_log_pkey",
      "contype": "p",
      "definition": "PRIMARY KEY (id)"
    },
    {
      "relname": "audit_log",
      "conname": "audit_log_resource_type_check",
      "contype": "c",
      "definition": "CHECK (btrim(resource_type) <> ''::text)"
    },
    {
      "relname": "auth_sessions",
      "conname": "auth_sessions_check",
      "contype": "c",
      "definition": "CHECK (expires_at > created_at)"
    },
    {
      "relname": "auth_sessions",
      "conname": "auth_sessions_check1",
      "contype": "c",
      "definition": "CHECK (revoked_at IS NULL OR revoked_at >= created_at)"
    },
    {
      "relname": "auth_sessions",
      "conname": "auth_sessions_pkey",
      "contype": "p",
      "definition": "PRIMARY KEY (id)"
    },
    {
      "relname": "auth_sessions",
      "conname": "auth_sessions_refresh_token_hash_check",
      "contype": "c",
      "definition": "CHECK (refresh_token_hash <> ''::text)"
    },
    {
      "relname": "auth_sessions",
      "conname": "auth_sessions_refresh_token_hash_key",
      "contype": "u",
      "definition": "UNIQUE (refresh_token_hash)"
    },
    {
      "relname": "auth_sessions",
      "conname": "auth_sessions_user_id_fkey",
      "contype": "f",
      "definition": "FOREIGN KEY (user_id) REFERENCES app.users(id) ON DELETE CASCADE"
    },
    {
      "relname": "schedule_dispatches",
      "conname": "schedule_dispatches_attempts_check",
      "contype": "c",
      "definition": "CHECK (attempts >= 0)"
    },
    {
      "relname": "schedule_dispatches",
      "conname": "schedule_dispatches_check",
      "contype": "c",
      "definition": "CHECK ((status = 'dispatched'::text) = (run_id IS NOT NULL))"
    },
    {
      "relname": "schedule_dispatches",
      "conname": "schedule_dispatches_pkey",
      "contype": "p",
      "definition": "PRIMARY KEY (id)"
    },
    {
      "relname": "schedule_dispatches",
      "conname": "schedule_dispatches_schedule_id_fkey",
      "contype": "f",
      "definition": "FOREIGN KEY (schedule_id) REFERENCES app.schedules(id) ON DELETE CASCADE"
    },
    {
      "relname": "schedule_dispatches",
      "conname": "schedule_dispatches_schedule_id_scheduled_for_key",
      "contype": "u",
      "definition": "UNIQUE (schedule_id, scheduled_for)"
    },
    {
      "relname": "schedule_dispatches",
      "conname": "schedule_dispatches_status_check",
      "contype": "c",
      "definition": "CHECK (status = ANY (ARRAY['pending'::text, 'dispatched'::text, 'skipped'::text, 'failed'::text]))"
    },
    {
      "relname": "schedules",
      "conname": "schedules_created_by_fkey",
      "contype": "f",
      "definition": "FOREIGN KEY (created_by) REFERENCES app.users(id) ON DELETE SET NULL"
    },
    {
      "relname": "schedules",
      "conname": "schedules_cron_expression_check",
      "contype": "c",
      "definition": "CHECK (btrim(cron_expression) <> ''::text)"
    },
    {
      "relname": "schedules",
      "conname": "schedules_name_check",
      "contype": "c",
      "definition": "CHECK (btrim(name) <> ''::text)"
    },
    {
      "relname": "schedules",
      "conname": "schedules_pkey",
      "contype": "p",
      "definition": "PRIMARY KEY (id)"
    },
    {
      "relname": "users",
      "conname": "users_display_name_check",
      "contype": "c",
      "definition": "CHECK (btrim(display_name) <> ''::text)"
    },
    {
      "relname": "users",
      "conname": "users_email_check",
      "contype": "c",
      "definition": "CHECK (email = btrim(email) AND email <> ''::text)"
    },
    {
      "relname": "users",
      "conname": "users_group_id_fkey",
      "contype": "f",
      "definition": "FOREIGN KEY (group_id) REFERENCES app.access_groups(id) ON DELETE RESTRICT"
    },
    {
      "relname": "users",
      "conname": "users_password_hash_check",
      "contype": "c",
      "definition": "CHECK (password_hash <> ''::text)"
    },
    {
      "relname": "users",
      "conname": "users_pkey",
      "contype": "p",
      "definition": "PRIMARY KEY (id)"
    }
  ],
  "indexes": [
