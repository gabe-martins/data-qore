  "constraints": [
    {
      "relname": "comparison_definitions",
      "conname": "comparison_definitions_absolute_tolerance_check",
      "contype": "c",
      "definition": "CHECK (absolute_tolerance >= 0::numeric AND absolute_tolerance < 'Infinity'::numeric)"
    },
    {
      "relname": "comparison_definitions",
      "conname": "comparison_definitions_check",
      "contype": "c",
      "definition": "CHECK (left_dataset_id <> right_dataset_id)"
    },
    {
      "relname": "comparison_definitions",
      "conname": "comparison_definitions_left_dataset_id_fkey",
      "contype": "f",
      "definition": "FOREIGN KEY (left_dataset_id) REFERENCES engine.datasets(id) ON DELETE RESTRICT"
    },
    {
      "relname": "comparison_definitions",
      "conname": "comparison_definitions_name_check",
      "contype": "c",
      "definition": "CHECK (btrim(name) <> ''::text)"
    },
    {
      "relname": "comparison_definitions",
      "conname": "comparison_definitions_name_key",
      "contype": "u",
      "definition": "UNIQUE (name)"
    },
    {
      "relname": "comparison_definitions",
      "conname": "comparison_definitions_options_check",
      "contype": "c",
      "definition": "CHECK (jsonb_typeof(comparison_options) = 'object'::text)"
    },
    {
      "relname": "comparison_definitions",
      "conname": "comparison_definitions_pkey",
      "contype": "p",
      "definition": "PRIMARY KEY (id)"
    },
    {
      "relname": "comparison_definitions",
      "conname": "comparison_definitions_relative_tolerance_check",
      "contype": "c",
      "definition": "CHECK (relative_tolerance >= 0::numeric AND relative_tolerance < 'Infinity'::numeric)"
    },
    {
      "relname": "comparison_definitions",
      "conname": "comparison_definitions_right_dataset_id_fkey",
      "contype": "f",
      "definition": "FOREIGN KEY (right_dataset_id) REFERENCES engine.datasets(id) ON DELETE RESTRICT"
    },
    {
      "relname": "comparison_definitions",
      "conname": "comparison_definitions_sampling_options_check",
      "contype": "c",
      "definition": "CHECK (jsonb_typeof(sampling_options) = 'object'::text)"
    },
    {
      "relname": "connections",
      "conname": "connections_connector_check",
      "contype": "c",
      "definition": "CHECK (connector = ANY (ARRAY['postgresql'::text, 'mysql'::text, 'mssql'::text, 'oracle'::text, 'sqlite'::text, 'databricks'::text]))"
    },
    {
      "relname": "connections",
      "conname": "connections_credentials_ciphertext_check",
      "contype": "c",
      "definition": "CHECK (credentials_ciphertext <> ''::text)"
    },
    {
      "relname": "connections",
      "conname": "connections_encryption_key_version_check",
      "contype": "c",
      "definition": "CHECK (encryption_key_version <> ''::text)"
    },
    {
      "relname": "connections",
      "conname": "connections_name_check",
      "contype": "c",
      "definition": "CHECK (btrim(name) <> ''::text)"
    },
    {
      "relname": "connections",
      "conname": "connections_name_key",
      "contype": "u",
      "definition": "UNIQUE (name)"
    },
    {
      "relname": "connections",
      "conname": "connections_pkey",
      "contype": "p",
      "definition": "PRIMARY KEY (id)"
    },
    {
      "relname": "datasets",
      "conname": "datasets_connection_id_fkey",
      "contype": "f",
      "definition": "FOREIGN KEY (connection_id) REFERENCES engine.connections(id) ON DELETE RESTRICT"
    },
    {
      "relname": "datasets",
      "conname": "datasets_metadata_check",
      "contype": "c",
      "definition": "CHECK (jsonb_typeof(metadata) = 'object'::text)"
    },
    {
      "relname": "datasets",
      "conname": "datasets_pkey",
      "contype": "p",
      "definition": "PRIMARY KEY (id)"
    },
    {
      "relname": "datasets",
      "conname": "datasets_source_identity_key",
      "contype": "u",
      "definition": "UNIQUE (connection_id, catalog_name, schema_name, table_name)"
    },
    {
      "relname": "datasets",
      "conname": "datasets_table_name_check",
      "contype": "c",
      "definition": "CHECK (table_name <> ''::text)"
    },
    {
      "relname": "run_results",
      "conname": "run_results_conclusion_check",
      "contype": "c",
      "definition": "CHECK (conclusion = ANY (ARRAY['compatible_in_sample'::text, 'difference_observed'::text, 'inconclusive'::text]))"
    },
    {
      "relname": "run_results",
      "conname": "run_results_format_version_check",
      "contype": "c",
      "definition": "CHECK (format_version > 0)"
    },
    {
      "relname": "run_results",
      "conname": "run_results_pkey",
      "contype": "p",
      "definition": "PRIMARY KEY (run_id)"
    },
    {
      "relname": "run_results",
      "conname": "run_results_result_check",
      "contype": "c",
      "definition": "CHECK (jsonb_typeof(result) = 'object'::text)"
    },
    {
      "relname": "run_results",
      "conname": "run_results_run_id_fkey",
      "contype": "f",
      "definition": "FOREIGN KEY (run_id) REFERENCES engine.runs(id) ON DELETE RESTRICT"
    },
    {
      "relname": "runs",
      "conname": "runs_check",
      "contype": "c",
      "definition": "CHECK (kind = 'comparison'::text AND comparison_id IS NOT NULL)"
    },
    {
      "relname": "runs",
      "conname": "runs_check1",
      "contype": "c",
      "definition": "CHECK (status = 'queued'::text AND started_at IS NULL AND finished_at IS NULL OR status = 'running'::text AND started_at IS NOT NULL AND finished_at IS NULL OR status = 'succeeded'::text AND started_at IS NOT NULL AND finished_at IS NOT NULL OR status = 'failed'::text AND finished_at IS NOT NULL)"
    },
    {
      "relname": "runs",
      "conname": "runs_check2",
      "contype": "c",
      "definition": "CHECK (started_at IS NULL OR started_at >= requested_at)"
    },
    {
      "relname": "runs",
      "conname": "runs_check3",
      "contype": "c",
      "definition": "CHECK (finished_at IS NULL OR finished_at >= requested_at)"
    },
    {
      "relname": "runs",
      "conname": "runs_check4",
      "contype": "c",
      "definition": "CHECK (finished_at IS NULL OR started_at IS NULL OR finished_at >= started_at)"
    },
    {
      "relname": "runs",
      "conname": "runs_comparison_id_fkey",
      "contype": "f",
      "definition": "FOREIGN KEY (comparison_id) REFERENCES engine.comparison_definitions(id) ON DELETE RESTRICT"
    },
    {
      "relname": "runs",
      "conname": "runs_idempotency_key_check",
      "contype": "c",
      "definition": "CHECK (idempotency_key IS NULL OR idempotency_key <> ''::text)"
    },
    {
      "relname": "runs",
      "conname": "runs_idempotency_key_key",
      "contype": "u",
      "definition": "UNIQUE (idempotency_key)"
    },
    {
      "relname": "runs",
      "conname": "runs_kind_check",
      "contype": "c",
      "definition": "CHECK (kind = 'comparison'::text)"
    },
    {
      "relname": "runs",
      "conname": "runs_parameters_check",
      "contype": "c",
      "definition": "CHECK (jsonb_typeof(parameters) = 'object'::text)"
    },
    {
      "relname": "runs",
      "conname": "runs_pkey",
      "contype": "p",
      "definition": "PRIMARY KEY (id)"
    },
    {
      "relname": "runs",
      "conname": "runs_status_check",
      "contype": "c",
      "definition": "CHECK (status = ANY (ARRAY['queued'::text, 'running'::text, 'succeeded'::text, 'failed'::text]))"
    }
  ],
